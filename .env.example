# ==========================================================
# NivaroBet environment template — NEVER commit real secrets
# ==========================================================

# Public site
NEXT_PUBLIC_SITE_URL=https://nivarobet.best

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Protected Vercel cron routes
CRON_SECRET=

# Gemini server-only AI (never prefix the key with NEXT_PUBLIC_)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional per-system overrides
GEMINI_AI_IMPORT_MODEL=
GEMINI_MONITORING_MODEL=
GEMINI_SEO_MODEL=

# Google Search Console ownership meta verification (token only)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional Search Console API automation (server-only)
GOOGLE_SEARCH_CONSOLE_SITE_URL=sc-domain:nivarobet.best
GOOGLE_SEARCH_CONSOLE_CLIENT_EMAIL=
GOOGLE_SEARCH_CONSOLE_PRIVATE_KEY=

# Optional rendered extraction for AI Import V2. Recommended for JS-heavy casino sites.
FIRECRAWL_API_KEY=

# Owner/admin Supabase Auth email (server-only)
ADMIN_EMAIL=owner@example.com

# Development/test: keep Georgia open. Enable only after final policy decision.
GE_BLOCK_ENABLED=false
